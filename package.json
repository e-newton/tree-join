{
  "name": "tree-join",
  "displayName": "Tree Join",
  "description": "Toggle, split, and join TypeScript/JavaScript/PHP/JSON constructs using tree-sitter.",
  "version": "1.2.0",
  "publisher": "EricNewton",
  "license": "MIT",
  "author": "Eric Newton",
  "icon": "images/icon.png",
  "homepage": "https://github.com/e-newton/tree-join#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-newton/tree-join.git"
  },
  "bugs": {
    "url": "https://github.com/e-newton/tree-join/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "tree-sitter",
    "typescript",
    "javascript",
    "php",
    "json",
    "formatter",
    "split",
    "join"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:php",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "Tree Join",
      "properties": {
        "tree-join.maxJoinLength": {
          "type": "number",
          "default": 100,
          "scope": "language-overridable",
          "markdownDescription": "Maximum line length for a join result; joins whose single-line result would exceed this are refused. Set to `0` to use the first `#editor.rulers#` column instead (falling back to 100 when no ruler is configured)."
        },
        "tree-join.trailingComma": {
          "type": "string",
          "enum": [
            "add",
            "preserve",
            "never"
          ],
          "enumDescriptions": [
            "Always add a trailing separator after the last element on split.",
            "Keep a trailing separator only if the source already had one.",
            "Never add a trailing separator on split."
          ],
          "default": "add",
          "scope": "language-overridable",
          "markdownDescription": "Trailing comma (or separator) behavior on split. Join always removes trailing separators."
        },
        "tree-join.bracketSpacing": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "markdownDescription": "Pad inside object-like braces on join (`{ a: 1 }` vs `{a: 1}`). Arrays and other non-object constructs are never padded."
        }
      }
    },
    "commands": [
      {
        "command": "tree-join.toggle",
        "title": "Tree Join: Toggle",
        "enablement": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|php|json|jsonc)$/"
      },
      {
        "command": "tree-join.join",
        "title": "Tree Join: Join",
        "enablement": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|php|json|jsonc)$/"
      },
      {
        "command": "tree-join.split",
        "title": "Tree Join: Split",
        "enablement": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|php|json|jsonc)$/"
      },
      {
        "command": "tree-join.splitRecursive",
        "title": "Tree Join: Split Recursive",
        "enablement": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|php|json|jsonc)$/"
      },
      {
        "command": "tree-join.joinRecursive",
        "title": "Tree Join: Join Recursive",
        "enablement": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|php|json|jsonc)$/"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs --prod",
    "build:dev": "node esbuild.config.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:icon": "node scripts/gen-icon.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "UPDATE_FIXTURES=1 vitest run",
    "build:test": "node esbuild.test.mjs",
    "test:integration": "npm run build && npm run build:test && vscode-test",
    "build:test:web": "node esbuild.web-test.mjs",
    "test:web": "npm run build && npm run build:test:web && vscode-test-web --browserType=chromium --headless --quality=stable --extensionDevelopmentPath=. --extensionTestsPath=out-test-web/index.js",
    "package": "vsce package",
    "prepare": "simple-git-hooks",
    "vscode:prepublish": "npm run build"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "lint-staged": "^15.3.0",
    "mocha": "^11.8.0",
    "ovsx": "^0.10.12",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "web-tree-sitter": "^0.25.10"
  }
}
